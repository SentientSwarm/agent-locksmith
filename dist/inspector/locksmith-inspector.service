# Reference inspection sidecar for agent-locksmith (AGENT-254).
# Run it as the same user as locksmithd: Locksmith refuses a socket
# served by any other uid.
[Unit]
Description=agent-locksmith inspection sidecar (PromptGuard 2 / CodeShield)
Before=locksmithd.service

[Service]
User=locksmith
Group=locksmith
RuntimeDirectory=locksmith-inspector
RuntimeDirectoryMode=0700
ExecStart=/opt/locksmith-inspector/venv/bin/python /opt/locksmith-inspector/locksmith_inspector.py --socket /run/locksmith-inspector/inspector.sock
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/locksmith-inspector
PrivateTmp=yes
PrivateNetwork=yes

[Install]
WantedBy=multi-user.target

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:locksmith:controlled-oauth-account-response:v1",
  "title": "Owner-bound OAuth account status and refresh response v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "connected_unbound",
            "reconnect_required"
          ]
        },
        "kind": {
          "enum": [
            "controlled_linear_v1",
            "linear_hosted_v1",
            "linear_hosted_fixture_v1",
            "slack_confidential_v1",
            "slack_confidential_fixture_v1"
          ]
        },
        "profile": {
          "type": "string"
        },
        "account_generation": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "config_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "token_expires_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_verified": {
          "const": true
        },
        "requested_scopes": {
          "enum": [
            [
              "read"
            ],
            [
              "search:read.public",
              "channels:history"
            ],
            null
          ]
        },
        "granted_scope": {
          "enum": [
            "read",
            null,
            "search:read.public,channels:history"
          ]
        },
        "token_version": {
          "type": "integer",
          "minimum": 0
        },
        "refresh_pending": {
          "type": "boolean"
        },
        "reconnect_required": {
          "type": "boolean"
        },
        "refresh_available": {
          "type": "boolean"
        },
        "refresh_unavailable_reason": {
          "enum": [
            null,
            "refresh_pending",
            "account_degraded",
            "registration_unavailable",
            "profile_conflict",
            "refresh_missing",
            "version_exhausted"
          ]
        },
        "refresh": {
          "$ref": "#/$defs/refresh"
        }
      },
      "required": [

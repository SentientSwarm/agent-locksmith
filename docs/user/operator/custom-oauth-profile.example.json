{
  "id": "customer",
  "kind": "custom-oauth-v1",
  "client_id": "invented-client",
  "client_generation": 1,
  "issuer": "https://identity.example.test",
  "authorization_endpoint": "https://identity.example.test/authorize",
  "token_endpoint": "https://identity.example.test/token",
  "resource": "https://api.example.test",
  "redirect_profile_id": "customer",
  "redirect_uri": "https://callback.example.test/oauth/callback/custom/customer",
  "ca_path": "./provider-ca.pem",
  "contract": {
    "version": 1,
    "grant": "authorization_code_s256",
    "registration": "pre_registered",
    "client_auth": "client_secret_post",
    "approved_origins": [
      "https://identity.example.test",
      "https://api.example.test"
    ],
    "mcp_endpoint": "https://api.example.test/mcp",
    "callback": "distinct_redirect",
    "scope": {
      "required": [
        "catalog:inspect",
        "records:read"
      ],
      "request_separator": "space",
      "response_separator": "space"
    },
    "token_response": "oauth2-bearer-v1",
    "identity": {
      "endpoint": "https://identity.example.test/whoami",
      "method": "get",
      "response": "workspace-user-v1"
    },
    "subject": {
      "kind": "user_workspace",
      "workspace_id": "tenant-example",
      "user_id": "person-example"
    }
  }
}
